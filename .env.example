# Copy to .env and fill in. Secrets set here take precedence over values entered in the UI.

# Web UI administrator (leave empty to have one generated in /data/initial-admin-password)
MA_ADMIN_PASSWORD=

# Cisco ISE ERS/OpenAPI account (ERS Admin role)
MA_ISE_PASSWORD=

# pxGrid password (only with pxgrid.auth: password)
MA_PXGRID_PASSWORD=

# API key for cloud or protected LLM endpoints (not needed for a local Ollama)
MA_LLM_API_KEY=

# First-run configuration template (copied to /data/config.yaml if absent)
# MA_CONFIG_TEMPLATE=/app/deploy/config.demo.yaml

# Pin GoFlow2 if you need a specific version
# GOFLOW2_IMAGE=netsampler/goflow2:latest
